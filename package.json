{
  "name": "@dan-build/agentstat",
  "version": "0.4.0",
  "description": "Live telemetry for LLM agents in React — token rate, progress, status, health and stall/spike/thrash detection on one canvas.",
  "author": "dan-build",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.dev.json",
    "lint": "eslint src tests dev examples",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:size": "node scripts/check-size.mjs",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:size",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "happy-dom": "^20.9.0",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "agent",
    "llm",
    "monitoring",
    "dashboard",
    "react",
    "canvas",
    "visualization",
    "telemetry",
    "observability",
    "agents",
    "ai-sdk",
    "streaming",
    "langchain",
    "vercel-ai",
    "real-time"
  ],
  "homepage": "https://github.com/dan-build/agentstat#readme",
  "bugs": {
    "url": "https://github.com/dan-build/agentstat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dan-build/agentstat.git"
  }
}
