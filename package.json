{
  "name": "@dan-build/agentstat",
  "version": "0.5.0",
  "description": "Live telemetry for LLM agents in React — token rate, progress, status, health and stall/spike/thrash detection on one canvas.",
  "author": "dan-build",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ai-sdk": {
      "import": {
        "types": "./dist/ai-sdk.d.ts",
        "default": "./dist/ai-sdk.js"
      },
      "require": {
        "types": "./dist/ai-sdk.d.cts",
        "default": "./dist/ai-sdk.cjs"
      }
    },
    "./ag-ui": {
      "import": {
        "types": "./dist/ag-ui.d.ts",
        "default": "./dist/ag-ui.js"
      },
      "require": {
        "types": "./dist/ag-ui.d.cts",
        "default": "./dist/ag-ui.cjs"
      }
    },
    "./langchain": {
      "import": {
        "types": "./dist/langchain.d.ts",
        "default": "./dist/langchain.js"
      },
      "require": {
        "types": "./dist/langchain.d.cts",
        "default": "./dist/langchain.cjs"
      }
    },
    "./sse": {
      "import": {
        "types": "./dist/sse.d.ts",
        "default": "./dist/sse.js"
      },
      "require": {
        "types": "./dist/sse.d.cts",
        "default": "./dist/sse.cjs"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/otel.d.ts",
        "default": "./dist/otel.js"
      },
      "require": {
        "types": "./dist/otel.d.cts",
        "default": "./dist/otel.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "ai-sdk": [
        "./dist/ai-sdk.d.ts"
      ],
      "ag-ui": [
        "./dist/ag-ui.d.ts"
      ],
      "langchain": [
        "./dist/langchain.d.ts"
      ],
      "sse": [
        "./dist/sse.d.ts"
      ],
      "otel": [
        "./dist/otel.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.dev.json",
    "lint": "eslint src tests dev examples",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:size": "node scripts/check-size.mjs",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:size && npm run test:dist",
    "prepublishOnly": "npm run check",
    "screenshots": "node scripts/screenshots.mjs",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "eval:detectors": "node scripts/eval-detectors.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "agent",
    "llm",
    "monitoring",
    "dashboard",
    "react",
    "canvas",
    "visualization",
    "telemetry",
    "observability",
    "agents",
    "ai-sdk",
    "streaming",
    "langchain",
    "vercel-ai",
    "real-time"
  ],
  "homepage": "https://github.com/dan-build/agentstat#readme",
  "bugs": {
    "url": "https://github.com/dan-build/agentstat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dan-build/agentstat.git"
  }
}
